{
  "name": "Base24 Summerfruit Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#d0d0d0",
    "editorLineNumber.foreground": "#505050",
    "editorLineNumber.activeForeground": "#b0b0b0",
    "editorCursor.foreground": "#d0d0d0",
    "editor.selectionBackground": "#303030",
    "editor.lineHighlightBackground": "#202020",
    "editorWhitespace.foreground": "#505050",
    "editorIndentGuide.background": "#202020",
    "editorIndentGuide.activeBackground": "#505050",
    "sideBar.background": "#101010",
    "sideBar.foreground": "#d0d0d0",
    "sideBarTitle.foreground": "#d0d0d0",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#d0d0d0",
    "statusBar.background": "#202020",
    "statusBar.foreground": "#b0b0b0",
    "tab.activeBackground": "#000000",
    "tab.inactiveBackground": "#202020",
    "tab.activeForeground": "#d0d0d0",
    "tab.inactiveForeground": "#b0b0b0",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#ff0086",
    "terminal.ansiGreen": "#00c918",
    "terminal.ansiYellow": "#aba800",
    "terminal.ansiBlue": "#3777e6",
    "terminal.ansiMagenta": "#ad00a1",
    "terminal.ansiCyan": "#1faaaa",
    "terminal.ansiWhite": "#d0d0d0",
    "terminal.ansiBrightBlack": "#505050",
    "terminal.ansiBrightRed": "#ff80c3",
    "terminal.ansiBrightGreen": "#4fff63",
    "terminal.ansiBrightYellow": "#fffd6e",
    "terminal.ansiBrightBlue": "#74a0ee",
    "terminal.ansiBrightMagenta": "#f400e4",
    "terminal.ansiBrightCyan": "#3fdcdc",
    "terminal.ansiBrightWhite": "#ffffff",
    "gitDecoration.addedResourceForeground": "#4fff63",
    "gitDecoration.modifiedResourceForeground": "#74a0ee",
    "gitDecoration.deletedResourceForeground": "#ff80c3",
    "editorError.foreground": "#ff0086",
    "editorWarning.foreground": "#fd8900",
    "editorInfo.foreground": "#1faaaa"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#505050"
      }
    },
    {
      "name": "Variables, Parameters",
      "scope": [
        "variable",
        "string constant.other.placeholder",
        "entity.name.variable.parameter",
        "entity.name.variable.local",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d0d0d0"
      }
    },
    {
      "name": "Variable Builtin",
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#d0d0d0"
      }
    },
    {
      "name": "Properties, Members",
      "scope": [
        "variable.other.object.property",
        "variable.other.property",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#b0b0b0"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#fd8900"
      }
    },
    {
      "name": "Constant Builtin",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#fd8900"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff0086"
      }
    },
    {
      "name": "Invalid - Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#cc6633"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ad00a1"
      }
    },
    {
      "name": "Keyword Control",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.from",
        "keyword.control.import",
        "keyword.control.as",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#ad00a1"
      }
    },
    {
      "name": "Keyword Import",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ad00a1"
      }
    },
    {
      "name": "Keyword Other",
      "scope": [
        "keyword.other.using",
        "keyword.other.namespace",
        "keyword.other.class",
        "keyword.other.new",
        "keyword.other.event",
        "keyword.other.this",
        "keyword.other.await",
        "keyword.other.var",
        "keyword.other.package",
        "keyword.other.import",
        "storage.type.ts",
        "storage.type.class",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#ad00a1"
      }
    },
    {
      "name": "Types, Primitives",
      "scope": [
        "keyword.type",
        "storage.type.primitive",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#aba800"
      }
    },
    {
      "name": "Type Builtin",
      "scope": [
        "support.type.builtin",
        "support.type.primitive"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#aba800"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#1faaaa"
      }
    },
    {
      "name": "Punctuation, Delimiters",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#d0d0d0"
      }
    },
    {
      "name": "Embedded",
      "scope": [
        "punctuation.section.embedded",
        "variable.interpolation"
      ],
      "settings": {
        "foreground": "#cc6633"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#ff0086"
      }
    },
    {
      "name": "Tag Builtin",
      "scope": [
        "support.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#fd8900"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#74a0ee"
      }
    },
    {
      "name": "Function Builtin",
      "scope": [
        "support.function.builtin"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#74a0ee"
      }
    },
    {
      "name": "Function Definition",
      "scope": [
        "entity.name.function",
        "meta.definition.function entity.name.function"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "Constructor",
      "scope": [
        "entity.name.function.constructor",
        "variable.function.constructor",
        "support.class.constructor"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3777e6"
      }
    },
    {
      "name": "Block Level Variables",
      "scope": [
        "meta.block variable.other"
      ],
      "settings": {
        "foreground": "#d0d0d0"
      }
    },
    {
      "name": "Other Variable, String Link",
      "scope": [
        "support.other.variable",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#ff0086"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.escape",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#fd8900"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#00c918"
      }
    },
    {
      "name": "String Escape, Regexp",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#1faaaa"
      }
    },
    {
      "name": "String Special Path",
      "scope": [
        "string.other.link",
        "markup.underline.link"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#3777e6"
      }
    },
    {
      "name": "String Special URL",
      "scope": [
        "*url*",
        "*link*",
        "*uri*"
      ],
      "settings": {
        "fontStyle": "italic underline",
        "foreground": "#ff0086"
      }
    },
    {
      "name": "Character",
      "scope": [
        "constant.character"
      ],
      "settings": {
        "foreground": "#1faaaa"
      }
    },
    {
      "name": "Class, Support",
      "scope": [
        "entity.name",
        "entity.name.class",
        "entity.name.type.class",
        "support.class",
        "support.other.namespace.use.php",
        "meta.use.php",
        "support.other.namespace.php",
        "markup.changed.git_gutter",
        "support.type.sys-types"
      ],
      "settings": {
        "foreground": "#3777E6"
      }
    },
    {
      "name": "Storage Type, Import Class",
      "scope": [
        "storage.type",
        "storage.modifier.package",
        "storage.modifier.import"
      ],
      "settings": {
        "foreground": "#AD00A1"
      }
    },
    {
      "name": "Fields",
      "scope": [
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#1faaaa"
      }
    },
    {
      "name": "Attribute Builtin",
      "scope": [
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#1faaaa"
      }
    },
    {
      "name": "CSS Class and Support",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name",
        "source.less support.type.property-name",
        "source.stylus support.type.property-name",
        "source.postcss support.type.property-name"
      ],
      "settings": {
        "foreground": "#1faaaa"
      }
    },
    {
      "name": "Sub-methods",
      "scope": [
        "entity.name.module.js",
        "variable.import.parameter.js",
        "variable.other.class.js"
      ],
      "settings": {
        "foreground": "#ff0086"
      }
    },
    {
      "name": "entity.name.method.js",
      "scope": [
        "entity.name.method.js"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#3777e6"
      }
    },
    {
      "name": "meta.method.js",
      "scope": [
        "meta.class-method.js entity.name.function.js",
        "variable.function.constructor"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": [
        "text.html.basic entity.other.attribute-name.html",
        "text.html.basic entity.other.attribute-name"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#aba800"
      }
    },
    {
      "name": "CSS Classes",
      "scope": [
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#aba800"
      }
    },
    {
      "name": "CSS ID's",
      "scope": [
        "source.sass keyword.control"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "PreProc, Include, Define, Macro",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.control.import",
        "keyword.control.include"
      ],
      "settings": {
        "foreground": "#1faaaa"
      }
    },
    {
      "name": "Inserted (Git)",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4fff63"
      }
    },
    {
      "name": "Deleted (Git)",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff80c3"
      }
    },
    {
      "name": "Changed (Git)",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#74a0ee"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "tag.decorator.js entity.name.tag.js",
        "tag.decorator.js punctuation.definition.tag.js",
        "meta.decorator"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#3777e6"
      }
    },
    {
      "name": "ES7 Bind Operator",
      "scope": [
        "source.js constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ad00a1"
      }
    },
    {
      "name": "JSON Key - Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "JSON Key - Level 1",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "JSON Key - Level 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "JSON Key - Level 3",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "JSON Key - Level 4",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "JSON Key - Level 5",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "JSON Key - Level 6",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "JSON Key - Level 7",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "JSON Key - Level 8",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "Markdown - Plain",
      "scope": [
        "text.html.markdown",
        "punctuation.definition.list_item.markdown"
      ],
      "settings": {
        "foreground": "#d0d0d0"
      }
    },
    {
      "name": "Markdown - Markup Raw Inline",
      "scope": [
        "text.html.markdown markup.inline.raw.markdown"
      ],
      "settings": {
        "foreground": "#b0b0b0"
      }
    },
    {
      "name": "Markdown - Markup Raw Inline Punctuation",
      "scope": [
        "text.html.markdown markup.inline.raw.markdown punctuation.definition.raw.markdown"
      ],
      "settings": {
        "foreground": "#1faaaa"
      }
    },
    {
      "name": "Markdown - Line Break",
      "scope": [
        "text.html.markdown meta.dummy.line-break"
      ],
      "settings": {
        "foreground": "#505050"
      }
    },
    {
      "name": "Markdown - Heading",
      "scope": [
        "markdown.heading",
        "markup.heading | markup.heading entity.name",
        "markup.heading.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "Markup - Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff0086"
      }
    },
    {
      "name": "Markup - Bold",
      "scope": [
        "markup.bold",
        "markup.bold string"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ff0086"
      }
    },
    {
      "name": "Markup - Bold-Italic",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold",
        "markup.quote markup.bold",
        "markup.bold markup.italic string",
        "markup.italic markup.bold string",
        "markup.quote markup.bold string"
      ],
      "settings": {
        "fontStyle": "bold italic",
        "foreground": "#ff0086"
      }
    },
    {
      "name": "Markup - Underline",
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#fd8900"
      }
    },
    {
      "name": "Markdown - Blockquote",
      "scope": [
        "markup.quote punctuation.definition.blockquote.markdown"
      ],
      "settings": {
        "foreground": "#1faaaa"
      }
    },
    {
      "name": "Markup - Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Link",
      "scope": [
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "name": "Markdown - Link Description",
      "scope": [
        "string.other.link.description.title.markdown"
      ],
      "settings": {
        "foreground": "#ad00a1"
      }
    },
    {
      "name": "Markdown - Link Anchor",
      "scope": [
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#aba800"
      }
    },
    {
      "name": "Markup - Raw Block",
      "scope": [
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#b0b0b0"
      }
    },
    {
      "name": "Markdown - Raw Block Fenced",
      "scope": [
        "markup.raw.block.fenced.markdown"
      ],
      "settings": {
        "foreground": "#505050"
      }
    },
    {
      "name": "Markdown - Fenced Bode Block",
      "scope": [
        "punctuation.definition.fenced.markdown"
      ],
      "settings": {
        "foreground": "#505050"
      }
    },
    {
      "name": "Markdown - Fenced Code Block Variable",
      "scope": [
        "markup.raw.block.fenced.markdown",
        "variable.language.fenced.markdown"
      ],
      "settings": {
        "foreground": "#ad00a1"
      }
    },
    {
      "name": "Markdown - Fenced Language",
      "scope": [
        "variable.language.fenced.markdown"
      ],
      "settings": {
        "foreground": "#ff0086"
      }
    },
    {
      "name": "Markdown - Separator",
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#1faaaa"
      }
    },
    {
      "name": "Markup - Table",
      "scope": [
        "markup.table"
      ],
      "settings": {
        "foreground": "#ad00a1"
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#3777e6"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#fd8900"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#ff0086"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#ad00a1"
      }
    }
  ]
}
